# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Configuration
# Get these from: https://dashboard.razorpay.com/app/settings/api-keys
REACT_APP_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx

# Note: RAZORPAY_KEY_SECRET should only be stored on your backend/server
# Never expose this in frontend code

# Optional: API Base URL (if you have a backend)
# REACT_APP_API_URL=http://localhost:5000
